# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vargani?retryWrites=true&w=majority

# Port (Optional, defaults to 5000 locally)
PORT=5000

# WhatsApp Cloud API credentials (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0
