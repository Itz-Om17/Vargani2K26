# ==============================================================
# Vercel Deployment Environment Variables
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================

# Required: MongoDB Atlas Connection URI
# e.g.: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vargani?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCOUNT_ID=
WHATSAPP_API_VERSION=v19.0

# Optional: Only needed if deploying Frontend and Backend to two separate Vercel projects
# VITE_API_URL=https://your-backend-project.vercel.app
